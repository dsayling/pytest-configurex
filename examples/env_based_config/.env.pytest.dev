# Development environment configuration
# Use with: ENV=dev pytest

X_VERBOSITY=2
X_LOG_CLI=true
X_LOG_LEVEL=DEBUG

# Skip slow tests in development
X_MARKERS=not slow

# Enable coverage in dev
X_COVERAGE_ENABLED=true
X_COVERAGE_SOURCE=src
X_COVERAGE_REPORT=term-missing

# Reporting options for development
X_DURATIONS=10
X_SHOWLOCALS=true
X_TBSTYLE=short
X_REPORTCHARS=fEsx
