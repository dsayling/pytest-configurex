# Example .env file for pytest-configurex
# Copy this to .env and customize for your project

# Built-in pytest options
LOG_LEVEL=DEBUG
TIMEOUT=30
ADDOPTS=-vv --strict-markers

# Custom fields (require registration via pytest_configurex_register hook)
# See conftest_example.py for how to register these

# pytest-cov options
COVERAGE_SOURCE=src
COVERAGE_REPORT=html

# pytest-xdist options
NUM_WORKERS=4

# Custom test configuration
TEST_MARKER=integration
VERBOSITY=2

# Application-specific settings
DATABASE_URL=postgresql://localhost/test_db
API_BASE_URL=http://localhost:8000
TEST_USER_EMAIL=test@example.com

# Feature flags for tests
ENABLE_EXPERIMENTAL_FEATURES=false
SKIP_SLOW_TESTS=true

# Environment-specific settings
TEST_ENV=development
DEBUG_MODE=true
