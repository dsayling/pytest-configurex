# Integration test configuration
# Tests that interact with external services

X_VERBOSITY=1
X_LOG_CLI=true
X_LOG_LEVEL=INFO

# Only run integration tests
X_MARKERS=integration

# Coverage for integration paths
X_COVERAGE_ENABLED=true
X_COVERAGE_SOURCE=src
X_COVERAGE_REPORT=html

# Sequential execution (integration tests may have dependencies)
# X_XDIST_NUMPROCESSES=1
