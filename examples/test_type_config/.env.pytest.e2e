# End-to-end test configuration
# Full system tests, slower but comprehensive

X_VERBOSITY=1
X_LOG_CLI=true
X_LOG_LEVEL=INFO
X_LOG_FILE=e2e_tests.log

# Only run e2e tests
X_MARKERS=e2e

# No coverage for e2e (too slow, focuses on integration not coverage)
X_COVERAGE_ENABLED=false

# Sequential execution (e2e tests often have state)
# Don't parallelize
