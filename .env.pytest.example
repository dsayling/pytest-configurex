# Example .env.pytest configuration file
# Copy this to .env.pytest and customize as needed

# Verbosity level (0-3)
# 0 = quiet, 1 = -v, 2 = -vv, 3 = -vvv
X_VERBOSITY=1

# Logging configuration
X_LOG_LEVEL=INFO
X_LOG_CLI=true
# X_LOG_FILE=pytest.log

# Test selection via markers
# X_MARKERS=not slow

# Coverage settings (requires pytest-cov)
# X_COVERAGE_ENABLED=true
# X_COVERAGE_SOURCE=src
# X_COVERAGE_REPORT=term-missing

# xdist settings (requires pytest-xdist)
# X_XDIST_NUMPROCESSES=4
# X_XDIST_DIST=loadscope
